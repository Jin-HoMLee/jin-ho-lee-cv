---
import type { Volunteer, Labels, Lang } from "../types/content";

interface Props {
  volunteer: Volunteer;
  labels: Labels;
  lang?: Lang;
}

const { volunteer, labels, lang = "en" } = Astro.props;
---
<section id="volunteer" class="py-6">
  <div class="editorial-section-head">
    <h2 class="eyebrow mb-3">{labels.sections.volunteer}</h2>
    <a class="section-back" href="#top">↑ {lang === "de" ? "Oben" : "Top"}</a>
  </div>
  <div class="space-y-3">
    {volunteer.categories.map((cat) => (
      <div>
        <p class="text-sm font-semibold text-[var(--text)]">{cat.name}</p>
        <ul class="mt-1 space-y-0.5 text-sm text-[var(--muted)]">
          {cat.entries.map((e) => (
            <li>{e}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
