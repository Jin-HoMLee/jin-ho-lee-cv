---
import type { Personal, Profile, Publication, Skills, Experience, Lang } from "../types/content";

interface Props {
  personal: Personal;
  profile: Profile;
  publications: Publication[];
  skills: Skills;
  experience: Experience[];
  lang: Lang;
}

const { personal, profile, publications, skills, experience, lang } = Astro.props;

// roots — curated positioning trio (renderer-authored, like OG kickers; NOT in content/)
const ROOTS = ["cancer-genomics", "HLA-typing", "neoantigens"];

// stack — derived spread across the arc. NOTE: the original plan used
// `categories.flatMap(c => c.groups.flatMap(g => g.items)).slice(0,4)`, but that only
// surfaced genomics items (the first category has 4 groups). bioLead + engLeads spans
// categories intentionally, so the hero signals bioinformatics → ML → cloud. Still fully
// derived from skills data; no hardcoded skill values.
const bioLead = skills.categories[0]?.groups?.[0]?.items?.[0];
const leadCategory = skills.categories.find((category) =>
  category.name === "Data & Engineering" || category.name === "Daten & Engineering"
) ?? skills.categories.at(-1);
const engLeads = (leadCategory?.groups ?? []).map((g) => g.items?.[0]).filter(Boolean);
const stack = [bioLead, ...engLeads].filter(Boolean).slice(0, 4);

const name = `${personal.name.given} ${personal.name.family}`;
const pubCount = publications.length;
const eyebrow = lang === "en"
  ? "// one source of truth — pdf · web · json · jsonld · text"
  : "// eine Quelle — pdf · web · json · jsonld · text";
const authorComment = lang === "en" ? "# first / shared-first author" : "# Erst-/geteilte Erstautorenschaft";
// --- experience.yaml panel data: one item per entry, derived from the prop ---
const presentLabel = lang === "en" ? "present" : "heute";
const expItems = experience.map((e) => ({
  role: e.role,
  org: e.org.name,
  period: `${e.period.start} → ${e.period.end ?? presentLabel}`,
}));
// experience panel line count: 3 lines per item (role / org / period)
const expLineCount = expItems.length * 3;

// --- publications.bib panel data: 3 first/shared-first entries, as BibTeX entries ---
// Strip BibTeX protective braces and decode common LaTeX escapes so text reads naturally.
function cleanTex(s: string): string {
  return s
    // normalize braced accent forms first: \"{u} -> \"u, \'{e} -> \'e, etc.
    .replace(/\\(["'`^~])\{(\w)\}/g, "\\$1$2")
    // umlauts / German
    .replace(/\\"u/g, "ü").replace(/\\"a/g, "ä").replace(/\\"o/g, "ö")
    .replace(/\\"U/g, "Ü").replace(/\\"A/g, "Ä").replace(/\\"O/g, "Ö")
    .replace(/\\ss/g, "ß")
    // common acute / grave / circumflex / tilde / cedilla (academic names & titles)
    .replace(/\\'e/g, "é").replace(/\\'E/g, "É").replace(/\\`e/g, "è")
    .replace(/\\'a/g, "á").replace(/\\`a/g, "à").replace(/\\\^a/g, "â")
    .replace(/\\'o/g, "ó").replace(/\\\^o/g, "ô").replace(/\\'i/g, "í")
    .replace(/\\'u/g, "ú").replace(/\\~n/g, "ñ").replace(/\\~N/g, "Ñ")
    .replace(/\\c\{?c\}?/g, "ç").replace(/\\c\{?C\}?/g, "Ç")
    // strip any remaining BibTeX protective braces
    .replace(/[{}]/g, "");
}
const BIBTYPE: Record<Publication["type"], string> = {
  article: "article",
  "book-chapter": "incollection",
  conference: "inproceedings",
  book: "book",
};
// Showcase the first 3 first/shared-first author, peer-reviewed entries (in array
// order). Conference contributions/abstracts are excluded so the hero surfaces the
// strongest published venues. Fully derived from the publications data — no hardcoded keys.
const bibPubs = publications
  .filter(
    (p) =>
      (p.authorship === "first" || p.authorship === "shared") &&
      p.type !== "conference",
  )
  .slice(0, 3)
  .map((p) => {
    const bibtype = BIBTYPE[p.type];
    const venuefield = p.type === "article" ? "journal" : "booktitle";
    const fields: { name: string; value: string }[] = [
      { name: "author", value: p.authors.join(" and ") },
      { name: "title", value: cleanTex(p.title) },
    ];
    if (p.venue) fields.push({ name: venuefield, value: cleanTex(p.venue) });
    fields.push({ name: "year", value: String(p.year) });
    if (p.doi) fields.push({ name: "doi", value: p.doi });
    return { key: p.key, bibtype, fields };
  });
// bib panel line count: per entry = 1 (@type{key,) + fields + 1 (}); plus a blank line between entries
const bibLineCount = bibPubs.reduce((n, e) => n + e.fields.length + 2, 0) + Math.max(0, bibPubs.length - 1);

const tabs = [
  { file: "profile.yaml", tabId: "tab-profile", panelId: "panel-profile" },
  { file: "experience.yaml", tabId: "tab-experience", panelId: "panel-experience" },
  { file: "publications.bib", tabId: "tab-publications", panelId: "panel-publications" },
];
---
<section id="source" class="terminal-dock" data-code-hero data-reveal aria-label={lang === "en" ? "CV source terminal" : "Lebenslauf-Quellterminal"}>
  <details class="terminal-shell">
    <summary class="terminal-launch">
      <span class="terminal-icon" aria-hidden="true">›_</span>
      <span>
        <b>{lang === "en" ? "Open CV source terminal" : "CV-Quellterminal öffnen"}</b>
        <small>profile.yaml · experience.yaml · publications.bib</small>
      </span>
      <span class="terminal-state">{lang === "en" ? "Launch" : "Öffnen"}</span>
    </summary>
    <p class="source-note">{eyebrow}</p>
    <div class="overflow-hidden border-t border-[var(--surface-border)]" style="background: var(--code-bg)">
    <!-- tab controls (real ARIA tablist) -->
    <div class="flex items-center text-[11px]" style="background: var(--code-chrome)" role="tablist" aria-label="Source files">
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={tab.tabId}
          class="cv-tab font-mono-plex px-3 py-2"
          data-cv-tab={tab.file}
          aria-controls={tab.panelId}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >{tab.file}</button>
      ))}
    </div>

    <!-- code body: one tabpanel per file, all server-rendered -->
    <!-- profile.yaml -->
    <div
      role="tabpanel"
      id="panel-profile"
      aria-labelledby="tab-profile"
      data-cv-panel="profile.yaml"
      class="flex font-mono-plex text-[13px] leading-[1.9]"
      tabindex="0"
    >
      {(() => {
        // Profile rows as a single source of truth: the gutter line-count derives from
        // rows.length, so the numbers can never silently drift from the rendered content.
        const rows = [
          <div><span class="ck">name</span>: <span class="cs">{name}</span></div>,
          <div><span class="ck">headline</span>: <span class="cs" data-cv-hero-headline>{personal.headline}</span></div>,
          <div><span class="ck">roots</span>: [{ROOTS.map((r, i) => <Fragment><span class="cs">{r}</span>{i < ROOTS.length - 1 ? ", " : ""}</Fragment>)}]</div>,
          <div><span class="ck">stack</span>: [<span class="cs" data-cv-hero-stack>{stack.join(", ")}</span>]</div>,
          <div><span class="ck">publications</span>: <span class="cn">{pubCount}</span>&nbsp;&nbsp;<span class="cc">{authorComment}</span></div>,
          <div><span class="ck">tagline</span>: <span class="cp">&gt;-</span></div>,
          <div>&nbsp;&nbsp;<span class="cs" data-cv-hero-tagline data-type={profile.tagline}>{profile.tagline}</span><span class="cursor" aria-hidden="true">&#x25AE;</span></div>,
          <div>&nbsp;</div>,
        ];
        return (
          <Fragment>
            <div class="select-none py-3 pl-3 pr-2 text-right" style="color: var(--code-gutter)" aria-hidden="true">
              {rows.map((_, i) => <div>{i + 1}</div>)}
            </div>
            <div class="overflow-x-auto py-3 pr-4">{rows}</div>
          </Fragment>
        );
      })()}
    </div>

    <!-- experience.yaml -->
    <div
      role="tabpanel"
      id="panel-experience"
      aria-labelledby="tab-experience"
      data-cv-panel="experience.yaml"
      class="flex font-mono-plex text-[13px] leading-[1.9]"
      tabindex="-1"
      hidden
    >
      <div class="select-none py-3 pl-3 pr-2 text-right" style="color: var(--code-gutter)" aria-hidden="true">
        {Array.from({ length: expLineCount }, (_, i) => <div>{i + 1}</div>)}
      </div>
      <div class="overflow-x-auto py-3 pr-4">
        {expItems.map((it) => (
          <Fragment>
            <div><span class="cp">-</span> <span class="ck">role</span>: <span class="cs">{it.role}</span></div>
            <div>&nbsp;&nbsp;<span class="ck">org</span>: <span class="cs">{it.org}</span></div>
            <div>&nbsp;&nbsp;<span class="ck">period</span>: <span class="cs">{it.period}</span></div>
          </Fragment>
        ))}
      </div>
    </div>

    <!-- publications.bib -->
    <div
      role="tabpanel"
      id="panel-publications"
      aria-labelledby="tab-publications"
      data-cv-panel="publications.bib"
      class="flex font-mono-plex text-[13px] leading-[1.9]"
      tabindex="-1"
      hidden
    >
      <div class="select-none py-3 pl-3 pr-2 text-right" style="color: var(--code-gutter)" aria-hidden="true">
        {Array.from({ length: bibLineCount }, (_, i) => <div>{i + 1}</div>)}
      </div>
      <div class="overflow-x-auto py-3 pr-4">
        {bibPubs.map((entry, idx) => (
          <Fragment>
            <div><span class="cp">@{entry.bibtype}</span>{"{"}<span class="cn">{entry.key}</span>,</div>
            {entry.fields.map((f) => (
              <div>&nbsp;&nbsp;<span class="ck">{f.name}</span> = {"{"}<span class="cs">{f.value}</span>{"}"},</div>
            ))}
            <div>{"}"}</div>
            {idx < bibPubs.length - 1 ? <div>&nbsp;</div> : null}
          </Fragment>
        ))}
      </div>
    </div>
  </div>

    </div>
  </details>
  <p class="signature-line"><span>STATIC-FIRST / SOURCE-ALIGNED / CRAWLER-READABLE</span><a href="#top">↑ {lang === "en" ? "Back to top" : "Nach oben"}</a></p>
</section>

<style>
  .terminal-dock { margin-bottom: 2.4rem; }
  .terminal-shell { border:1px solid var(--surface-border); background:color-mix(in srgb,var(--surface) 72%,var(--bg)); box-shadow:0 14px 42px color-mix(in srgb,var(--accent) 10%,transparent); }
  .terminal-launch { display:grid; grid-template-columns:auto 1fr auto; gap:14px; align-items:center; padding:16px 18px; cursor:pointer; list-style:none; }
  .terminal-launch::-webkit-details-marker { display:none; }
  .terminal-launch:hover { background:color-mix(in srgb,var(--accent) 8%,transparent); }
  .terminal-icon { width:44px; height:38px; display:grid; place-items:center; background:#1d2e3d; color:#2dd4bf; font:700 18px "IBM Plex Mono",monospace; border:1px solid #3d5261; }
  .terminal-launch b { display:block; font:600 13px "IBM Plex Mono",monospace; }
  .terminal-launch small { display:block; color:var(--muted); margin-top:2px; }
  .terminal-state { color:var(--accent); font:11px "IBM Plex Mono",monospace; text-transform:uppercase; }
  .terminal-shell[open] .terminal-state { font-size:0; }
  .terminal-shell[open] .terminal-state::before { content:"Close"; font-size:11px; }
  .source-note { margin:0; padding:.45rem 1rem; color:var(--muted); border-top:1px solid var(--surface-border); font:10px "IBM Plex Mono",monospace; }
  .signature-line { display:flex; justify-content:space-between; gap:1rem; margin:.45rem 0 0; color:var(--accent); font:10px "IBM Plex Mono",monospace; }
  .signature-line a { text-transform:uppercase; }
  .ck { color: var(--code-key); }
  .cs { color: var(--code-string); }
  .cn { color: var(--code-number); }
  .cc { color: var(--code-comment); }
  .cp { color: var(--code-punct); }
  .cursor { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }
  @media(max-width:700px) { .terminal-launch { grid-template-columns:auto 1fr; } .terminal-state { display:none; } .signature-line span { font-size:8px; } }

  .cv-tab {
    cursor: pointer;
    background: transparent;
    border: none;
    border-top: 2px solid transparent;
    color: var(--code-comment);
  }
  .cv-tab[aria-selected="true"] {
    color: var(--text);
    border-top: 2px solid var(--accent);
    background: var(--code-bg);
  }
  .cv-tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>

<script>
  // Tagline typing island — types once on load, reduced-motion safe.
  const taglineEl = document.querySelector<HTMLElement>("[data-code-hero] [data-cv-hero-tagline]");
  const headlineEl = document.querySelector<HTMLElement>("[data-code-hero] [data-cv-hero-headline]");
  const stackEl = document.querySelector<HTMLElement>("[data-code-hero] [data-cv-hero-stack]");
  const bridgeHeadline = headlineEl?.textContent ?? "";
  const bridgeTagline = taglineEl?.dataset.type ?? taglineEl?.textContent ?? "";
  const bridgeStack = stackEl?.textContent ?? "";
  let typingTimer: ReturnType<typeof setTimeout> | undefined;

  if (taglineEl) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce) {
      taglineEl.textContent = "";
      let i = 0;
      const tick = () => {
        taglineEl.textContent = bridgeTagline.slice(0, ++i);
        if (i < bridgeTagline.length) typingTimer = setTimeout(tick, 16);
      };
      tick();
    }
    // reduced-motion: leave the already-rendered full text in place.
  }

  if (headlineEl || taglineEl || stackEl) {
    window.addEventListener("cv-target-change", (event) => {
      const detail = (event as CustomEvent<{
        target?: string;
        headline?: unknown;
        tagline?: unknown;
        hero_stack?: unknown;
      }>).detail;
      if (!detail?.target) return;

      if (typingTimer !== undefined) {
        clearTimeout(typingTimer);
        typingTimer = undefined;
      }

      const nextHeadline = detail.target === "bridge"
        ? bridgeHeadline
        : typeof detail.headline === "string" ? detail.headline : bridgeHeadline;
      const nextTagline = detail.target === "bridge"
        ? bridgeTagline
        : typeof detail.tagline === "string" ? detail.tagline : bridgeTagline;
      const nextStack = detail.target === "bridge"
        ? bridgeStack
        : Array.isArray(detail.hero_stack) && detail.hero_stack.every((item) => typeof item === "string")
          ? detail.hero_stack.join(", ")
          : bridgeStack;

      if (headlineEl) headlineEl.textContent = nextHeadline;
      if (taglineEl) taglineEl.textContent = nextTagline;
      if (stackEl) stackEl.textContent = nextStack;
    });
  }

  // ARIA tabs island — click + keyboard, roving tabindex.
  const root = document.querySelector<HTMLElement>("[data-code-hero]");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    function activate(index: number, setFocus: boolean) {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute("aria-selected", selected ? "true" : "false");
        tab.tabIndex = selected ? 0 : -1;
        const panel = panels.find((p) => p.id === tab.getAttribute("aria-controls"));
        if (panel) {
          panel.hidden = !selected;
          panel.tabIndex = selected ? 0 : -1;
        }
      });
      if (setFocus) tabs[index]?.focus();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => activate(i, true));
      tab.addEventListener("keydown", (e) => {
        let next = -1;
        switch (e.key) {
          case "ArrowRight":
            next = (i + 1) % tabs.length;
            break;
          case "ArrowLeft":
            next = (i - 1 + tabs.length) % tabs.length;
            break;
          case "Home":
            next = 0;
            break;
          case "End":
            next = tabs.length - 1;
            break;
          default:
            return;
        }
        e.preventDefault();
        activate(next, true);
      });
    });
  }
</script>
