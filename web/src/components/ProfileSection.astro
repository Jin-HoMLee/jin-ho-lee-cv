---
import type { Personal, Profile, Labels, Lang } from "../types/content";

interface Props {
  personal: Personal;
  profile: Profile;
  labels: Labels;
  lang?: Lang;
}

const { profile, labels, lang = "en" } = Astro.props;
---
<section id="profile" class="editorial-section">
  <div class="editorial-section-head"><h2 class="eyebrow">{labels.sections.profile}</h2><a class="section-back" href="#top">↑ {lang === "de" ? "Oben" : "Top"}</a></div>
  <div>
      {profile.answer_block && (
        <p
          class="text-base leading-relaxed text-[var(--text)]"
          data-cv-field="answer-block"
        >{profile.answer_block}</p>
      )}
      <p class="mt-3 text-lg font-medium text-[var(--text)]" data-cv-field="tagline">{profile.tagline}</p>
      {profile.paragraphs.map((p, i) => (
        <p class="mt-3 leading-relaxed text-[var(--muted)]" data-cv-field={i === 0 ? "lead" : i === 1 ? "second" : undefined}>{p}</p>
      ))}
    </div>
  <p class="mt-5"><a class="archive-link" href={lang === "de" ? "/de/archive/" : "/archive/"}>{lang === "de" ? "Vollständigen CV-Index öffnen" : "Open complete CV index"} →</a></p>
</section>
<style>.archive-link{color:var(--accent);font:600 .75rem "IBM Plex Mono",monospace;text-decoration:none;border-bottom:1px solid currentColor}</style>
