---
import type { Award, Labels, Lang } from "../types/content";

interface Props {
  awards: Award[];
  labels: Labels;
  lang?: Lang;
}

const { awards, labels, lang = "en" } = Astro.props;
---
<section id="awards" class="py-6">
  <div class="editorial-section-head">
    <h2 class="eyebrow mb-3">{labels.sections.awards}</h2>
    <a class="section-back" href="#top">↑ {lang === "de" ? "Oben" : "Top"}</a>
  </div>
  <div class="space-y-3">
    {awards.map((a) => (
      <div>
        <p class="text-sm font-semibold text-[var(--text)]">{a.title} <span class="font-normal text-[var(--faint)]">· {a.year}</span></p>
        <p class="text-sm text-[var(--muted)]">{a.issuer}</p>
        {a.note && <p class="text-xs text-[var(--faint)]">{a.note}</p>}
      </div>
    ))}
  </div>
</section>
