---
import type { Award, Labels } from "../types/content";

interface Props {
  awards: Award[];
  labels: Labels;
}

const { awards, labels } = Astro.props;
---
<section id="awards" class="py-6">
  <h2 class="eyebrow mb-3">
    {labels.sections.awards}
  </h2>
  <div class="space-y-3">
    {awards.map((a) => (
      <div>
        <p class="text-sm font-semibold text-[var(--text)]">{a.title} <span class="font-normal text-[var(--faint)]">· {a.year}</span></p>
        <p class="text-sm text-[var(--muted)]">{a.issuer}</p>
        {a.note && <p class="text-xs text-[var(--faint)]">{a.note}</p>}
      </div>
    ))}
  </div>
</section>
