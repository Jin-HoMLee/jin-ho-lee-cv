---
import type { Skills, Labels, Lang } from "../types/content";

interface SkillVariant {
  skills?: Skills;
}

interface Props {
  skills: Skills;
  labels: Labels;
  variants?: Record<string, SkillVariant>;
  lang?: Lang;
}

const { skills, labels, variants = {}, lang = "en" } = Astro.props;
---
<section id="skills" class="editorial-section" data-cv-skills>
  <div class="editorial-section-head"><h2 class="eyebrow">05 / {labels.sections.skills}</h2><a class="section-back" href="#top">↑ {lang === "de" ? "Oben" : "Top"}</a></div>
  <div class="space-y-5" data-cv-skills-content>
    {skills.categories.map((cat) => (
      <div>
        <h3 class="mb-2 text-sm font-semibold text-[var(--text)]">{cat.name}</h3>
        <div class="space-y-2">
          {cat.groups.map((g) => (
            <div>
              <p class="text-xs font-medium text-[var(--muted)]">{g.label}</p>
              <ul class="mt-1 flex flex-wrap gap-1">
                {g.items.map((item) => (
                  <li class="skill-label">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
  <p class="mt-5"><a class="archive-link" href={lang === "de" ? "/de/skills/" : "/skills/"}>{lang === "de" ? "Alle Skills durchsuchen und filtern" : "Search and filter all skills"} →</a></p>
</section>
<style>
  .skill-label { position:relative; padding-left:.7rem; color:var(--text); font-size:.75rem; }
  .skill-label::before { content:""; position:absolute; left:0; top:.55em; width:4px; height:4px; border-radius:50%; background:var(--gold); }
  .archive-link { color:var(--accent); font:600 .75rem "IBM Plex Mono",monospace; text-decoration:none; border-bottom:1px solid currentColor; }
</style>

<script is:inline define:vars={{ skills, variants }}>
  (function () {
    // Skills are resolved in Python and passed as complete target trees. This
    // small progressive-enhancement renderer only swaps text nodes; it never
    // interprets HTML from content YAML.
    const root = document.querySelector("[data-cv-skills]");
    const content = root?.querySelector("[data-cv-skills-content]");
    const STORAGE_KEY = "cvTargetPreference";
    const VALID_TARGETS = new Set(["bridge", "comp-bio", "ds-ml"]);

    function element(tag, className, text) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text != null) node.textContent = text;
      return node;
    }

    function renderSkills(data) {
      if (!content || !data?.categories) return;
      content.replaceChildren();
      for (const category of data.categories) {
        const categoryNode = element("div");
        categoryNode.appendChild(element("h3", "mb-2 text-sm font-semibold text-[var(--text)]", category.name));
        const groupsNode = element("div", "space-y-2");
        for (const group of category.groups) {
          const groupNode = element("div");
          groupNode.appendChild(element("p", "text-xs font-medium text-[var(--muted)]", group.label));
          const itemsNode = element("ul", "mt-1 flex flex-wrap gap-1");
          for (const item of group.items) {
            itemsNode.appendChild(element("li", "skill-label", item));
          }
          groupNode.appendChild(itemsNode);
          groupsNode.appendChild(groupNode);
        }
        categoryNode.appendChild(groupsNode);
        content.appendChild(categoryNode);
      }
    }

    function applyTarget(target) {
      const data = target === "bridge" ? skills : variants[target]?.skills ?? skills;
      renderSkills(data);
    }

    window.addEventListener("cv-target-change", (event) => {
      const target = event.detail && event.detail.target;
      if (target && VALID_TARGETS.has(target)) applyTarget(target);
    });

    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved && VALID_TARGETS.has(saved)) applyTarget(saved);
    } catch {
      /* storage may be unavailable (private mode); keep the bridge view */
    }
  })();
</script>
