---
import type { Skills, Labels } from "../types/content";

interface Props {
  skills: Skills;
  labels: Labels;
}

const { skills, labels } = Astro.props;
---
<section id="skills" class="py-6">
  <h2 class="eyebrow mb-4">
    {labels.sections.skills}
  </h2>
  <div class="space-y-5">
    {skills.categories.map((cat) => (
      <div>
        <h3 class="mb-2 text-sm font-semibold text-[var(--text)]">{cat.name}</h3>
        <div class="space-y-2">
          {cat.groups.map((g) => (
            <div>
              <p class="text-xs font-medium text-[var(--muted)]">{g.label}</p>
              <ul class="mt-1 flex flex-wrap gap-1">
                {g.items.map((item) => (
                  <li class="font-mono-plex rounded bg-[var(--surface)] px-1.5 py-0.5 text-xs text-[var(--muted)]">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
