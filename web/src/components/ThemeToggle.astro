---
interface Props { class?: string; lang?: "en" | "de" }
const { class: className = "", lang = "en" } = Astro.props;
---
<button type="button" data-theme-toggle class:list={["theme-toggle", className]} aria-label={lang === "de" ? "Zum dunklen Modus wechseln" : "Switch to dark mode"} aria-pressed="false" title={lang === "de" ? "Zum dunklen Modus wechseln" : "Switch to dark mode"}>◐</button>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  const sync = () => {
    const dark = document.documentElement.dataset.theme === "dark";
    for (const button of buttons) {
      const de = document.documentElement.lang === "de";
      const label = dark ? (de ? "Zum hellen Modus wechseln" : "Switch to light mode") : (de ? "Zum dunklen Modus wechseln" : "Switch to dark mode");
      button.textContent = dark ? "◑" : "◐";
      button.setAttribute("aria-pressed", String(dark));
      button.setAttribute("aria-label", label);
      button.title = label;
    }
  };
  sync();
  window.addEventListener("cv-theme-change", sync);
  for (const button of buttons) button.addEventListener("click", () => {
    (window as Window & { toggleCvTheme?: () => void }).toggleCvTheme?.();
    sync();
  });
</script>
<style>
  .theme-toggle { width:42px; height:42px; display:grid; place-items:center; border:1px solid var(--surface-border); background:var(--surface); color:var(--text); font-size:19px; line-height:1; cursor:pointer; }
  .theme-toggle:hover { border-color:var(--accent); color:var(--accent); }
</style>
