---
import type { Education, Labels, Lang } from "../types/content";

interface Props {
  education: Education[];
  labels: Labels;
  lang?: Lang;
}

const { education, labels, lang = "en" } = Astro.props;
---
<section id="education" class="editorial-section">
  <div class="editorial-section-head"><h2 class="eyebrow">06 / {labels.sections.education}</h2><a class="section-back" href="#top">↑ {lang === "de" ? "Oben" : "Top"}</a></div>
  <div class="space-y-3">
    {education.map((ed) => (
      <div>
        <p class="text-sm font-semibold text-[var(--text)]">{ed.degree}</p>
        {ed.field && <p class="text-sm text-[var(--muted)]">{ed.field}</p>}
        {ed.thesis && <p class="text-xs italic text-[var(--faint)]">Thesis: {ed.thesis}</p>}
        <p class="text-sm text-[var(--muted)]">{ed.institution} · {ed.location}</p>
        <p class="text-xs text-[var(--faint)]">{ed.year}</p>
      </div>
    ))}
  </div>
  <p class="mt-5"><a class="archive-link" href={lang === "de" ? "/de/education/" : "/education/"}>{lang === "de" ? "Bildungsverlauf öffnen" : "Open education chronology"} →</a></p>
</section>
<style>.archive-link{color:var(--accent);font:600 .75rem "IBM Plex Mono",monospace;text-decoration:none;border-bottom:1px solid currentColor}</style>
