---
import type { Experience, Project, Labels, Lang } from "../types/content";
import { formatPeriod } from "../lib/period";

interface Props {
  experience: Experience[];
  projects: Record<string, Project>;
  labels: Labels;
  lang: Lang;
  variants?: Record<string, { order?: string[] }>;
}

const { experience, labels, lang, variants = {} } = Astro.props;
---
<section id="experience" class="editorial-section" data-cv-experience>
  <div class="editorial-section-head"><h2 class="eyebrow">02 / {labels.sections.experience}</h2><a class="section-back" href="#top">↑ {lang === "de" ? "Nach oben" : "Back to top"}</a></div>
  <div class="space-y-6" data-cv-experience-list>
    {experience.map((exp) => (
      <article id={`exp-${exp.id}`} class="experience-role">
        <p class="experience-date">{formatPeriod(exp.period, labels)}</p>
        <div class="experience-body">
        <header class="mb-2">
          <h3 class="text-base font-semibold text-[var(--text)]">{exp.role}</h3>
          <p class="experience-org">{exp.org.name}</p>
        </header>
        <ul class="space-y-1.5 text-sm text-[var(--muted)]">
          {exp.bullets.map((b) => (
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-[var(--accent)]">▸</span>
              <span>
                {b[lang]}
                {b.refs && b.refs.length > 0 && (
                  <span class="ml-1 inline-flex gap-1">
                    {b.refs.map((r) => (
                      <a
                        href={lang === "de" ? `/de/projects/${r}/` : `/projects/${r}/`}
                        class="font-mono-plex rounded bg-[var(--surface)] px-1.5 py-0.5 text-xs font-medium text-[var(--accent)] no-underline hover:bg-[var(--surface-2)]"
                      >{r}</a>
                    ))}
                  </span>
                )}
              </span>
            </li>
          ))}
        </ul>
        </div>
      </article>
    ))}
  </div>
  <p class="mt-5"><a class="archive-link" href={lang === "de" ? "/de/experience/" : "/experience/"}>{lang === "de" ? "Vollständigen Erfahrungsverlauf öffnen" : "Open full experience chronology"} →</a></p>
</section>
<style>
  .experience-role { display:grid; grid-template-columns:100px 1fr; gap:1.5rem; padding:0 0 1.9rem; }
  .experience-date { color:var(--accent); font:600 .75rem "IBM Plex Mono",monospace; }
  .experience-body { border-left:2px solid var(--accent); padding-left:1.25rem; }
  .experience-org { color:var(--gold); font-size:.8rem; font-weight:600; }
  .archive-link { color:var(--accent); font:600 .75rem "IBM Plex Mono",monospace; text-decoration:none; border-bottom:1px solid currentColor; }
  @media(max-width:700px) { .experience-role { grid-template-columns:1fr; gap:.35rem; } }
</style>
<script is:inline define:vars={{ experience, variants }}>
  // Experience content is identical across targets; only the bullet order within
  // each object changes. Reorder the already-rendered article blocks to match the
  // active target (bridge is the canonical order), mirroring the PDF variant order.
  const root = document.querySelector("[data-cv-experience]");
  const list = root?.querySelector("[data-cv-experience-list]");
  if (!root || !list) return;

  const VALID_TARGETS = new Set(["comp-bio", "ds-ml"]);
  const canonicalOrder = experience.map((e) => e.id);

  function orderFor(target) {
    const order = variants[target]?.order;
    return Array.isArray(order) && order.length ? order : canonicalOrder;
  }

  function apply(target) {
    const order = orderFor(target);
    const articles = Array.from(list.querySelectorAll("article"));
    const byId = new Map(articles.map((article) => [article.id.replace("exp-", ""), article]));
    const fragment = document.createDocumentFragment();
    for (const id of order) {
      const article = byId.get(id);
      if (article) fragment.appendChild(article);
    }
    list.appendChild(fragment);
  }

  window.addEventListener("cv-target-change", (event) => {
    const target = event.detail && event.detail.target;
    if (target && (target === "bridge" || VALID_TARGETS.has(target))) apply(target);
  });
</script>
