---
import type { Publication, Lang } from "../types/content";

interface Props {
  publications: Publication[];
  lang: Lang;
}

const { publications, lang } = Astro.props;

const yearCounts: Record<number, number> = {};
for (const p of publications) {
  yearCounts[p.year] = (yearCounts[p.year] ?? 0) + 1;
}
const sortedYears = Object.keys(yearCounts).map(Number).sort((a, b) => a - b);

const points: { year: number; cum: number }[] = [];
let running = 0;
for (const y of sortedYears) {
  running += yearCounts[y];
  points.push({ year: y, cum: running });
}
const total = running;
const minYear = sortedYears[0] ?? 0;
const dataMaxYear = sortedYears[sortedYears.length - 1] ?? 0;
const currentYear = new Date().getUTCFullYear();
const maxYear = Math.max(dataMaxYear, currentYear);
// Pad the X domain on the left so the "0" Y label and the first-year X label
// don't collide. Right edge stays flush at maxYear.
const xDomainMin = minYear - 0.7;
const xDomainSpan = Math.max(1, maxYear - xDomainMin);

const W = 480;
const H = 130;
const padL = 36;
const padR = 12;
const padT = 10;
const padB = 32;
const chartLeft = padL;
const chartRight = W - padR;
const chartTop = padT;
const chartBottom = H - padB;

const xScale = (year: number) =>
  chartLeft + ((year - xDomainMin) / xDomainSpan) * (chartRight - chartLeft);
const yScale = (cum: number) =>
  total === 0 ? chartBottom : chartBottom - (cum / total) * (chartBottom - chartTop);

function buildArea(): string {
  if (points.length === 0) return "";
  const segs: string[] = [];
  // Start at the y-axis at baseline, run flat along baseline until the first
  // data year, then jump up. Visually conveys "0 publications before 2017".
  segs.push(`M ${chartLeft} ${chartBottom}`);
  segs.push(`L ${xScale(points[0].year)} ${chartBottom}`);
  segs.push(`L ${xScale(points[0].year)} ${yScale(points[0].cum)}`);
  for (let i = 1; i < points.length; i++) {
    segs.push(`L ${xScale(points[i].year)} ${yScale(points[i - 1].cum)}`);
    segs.push(`L ${xScale(points[i].year)} ${yScale(points[i].cum)}`);
  }
  segs.push(`L ${chartRight} ${yScale(points[points.length - 1].cum)}`);
  segs.push(`L ${chartRight} ${chartBottom}`);
  segs.push(`Z`);
  return segs.join(" ");
}

function buildLine(): string {
  if (points.length === 0) return "";
  const segs: string[] = [];
  segs.push(`M ${xScale(points[0].year)} ${yScale(points[0].cum)}`);
  for (let i = 1; i < points.length; i++) {
    segs.push(`L ${xScale(points[i].year)} ${yScale(points[i - 1].cum)}`);
    segs.push(`L ${xScale(points[i].year)} ${yScale(points[i].cum)}`);
  }
  segs.push(`L ${chartRight} ${yScale(points[points.length - 1].cum)}`);
  return segs.join(" ");
}

const areaPath = buildArea();
const linePath = buildLine();

const xTicks: number[] = [];
for (let y = minYear; y <= maxYear; y++) {
  xTicks.push(y);
}

const yTicks = [0, total];

const totalLabel = { en: "publications", de: "Publikationen" }[lang];
const ariaLabel = lang === "en"
  ? `Cumulative count of ${total} publications from ${minYear} to ${maxYear}`
  : `Kumulative Anzahl von ${total} Publikationen von ${minYear} bis ${maxYear}`;
const captionLabel = { en: "Cumulative over time", de: "Kumulativ über Zeit" }[lang];
---
<figure class="relative my-6">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="w-full max-h-40"
    role="img"
    aria-label={ariaLabel}
  >
    <line x1={chartLeft} y1={chartTop} x2={chartLeft} y2={chartBottom} style="stroke: var(--surface-border)" stroke-width="0.5" />
    <line x1={chartLeft} y1={chartBottom} x2={chartRight} y2={chartBottom} style="stroke: var(--surface-border)" stroke-width="0.5" />
    <path d={areaPath} style="fill: var(--accent)" fill-opacity="0.18" />
    <path d={linePath} fill="none" style="stroke: var(--accent)" stroke-width="1.5" stroke-linejoin="miter" />
    {points.map((pt, i) => {
      const x = xScale(pt.year);
      const prevCum = i === 0 ? 0 : points[i - 1].cum;
      const delta = pt.cum - prevCum;
      // Half-year bands left and right of each data point
      const halfBand = (chartRight - chartLeft) / xDomainSpan / 2;
      return (
        <rect
          x={x - halfBand}
          y={chartTop}
          width={halfBand * 2}
          height={chartBottom - chartTop}
          fill="transparent"
          data-year={pt.year}
          data-cum={pt.cum}
          data-delta={delta}
          class="cursor-pointer"
        />
      );
    })}
    {yTicks.map((v) => (
      <text x={chartLeft - 5} y={yScale(v) + 4} text-anchor="end" font-size="11" style="fill: var(--faint)">{v}</text>
    ))}
    {xTicks.map((y) => (
      <text x={xScale(y)} y={chartBottom + 14} text-anchor="middle" font-size="11" style="fill: var(--faint)">{y}</text>
    ))}
  </svg>
  <figcaption class="mt-1 text-xs text-[var(--faint)]">
    {captionLabel} · {total} {totalLabel}
  </figcaption>
  <div
    class="pub-tooltip pointer-events-none absolute hidden rounded bg-[var(--surface-border)] px-2 py-1 text-xs text-[var(--text)] shadow-lg"
    role="status"
    aria-live="polite"
  ></div>
</figure>

<script>
  // Hover (or tap) a year band on the cumulative chart to show year + cumulative + delta.
  const figures = document.querySelectorAll<HTMLElement>("figure.relative");
  for (const fig of figures) {
    const tooltip = fig.querySelector<HTMLElement>(".pub-tooltip");
    const rects = fig.querySelectorAll<SVGRectElement>("svg rect[data-year]");
    if (!tooltip || rects.length === 0) continue;

    const show = (e: MouseEvent | TouchEvent, target: SVGRectElement) => {
      const year = target.dataset.year ?? "";
      const cum = target.dataset.cum ?? "";
      const delta = target.dataset.delta ?? "";
      const deltaStr = Number(delta) > 0 ? ` (+${delta})` : "";
      tooltip.textContent = `${year}: ${cum}${deltaStr}`;
      tooltip.classList.remove("hidden");
      const rect = fig.getBoundingClientRect();
      const point = "touches" in e ? e.touches[0] : e;
      tooltip.style.left = `${point.clientX - rect.left + 8}px`;
      tooltip.style.top = `${point.clientY - rect.top + 8}px`;
    };
    const hide = () => tooltip.classList.add("hidden");

    rects.forEach((r) => {
      r.addEventListener("mouseenter", (e) => show(e, r));
      r.addEventListener("mousemove", (e) => show(e, r));
      r.addEventListener("mouseleave", hide);
      r.addEventListener("touchstart", (e) => {
        e.preventDefault();
        if (tooltip.classList.contains("hidden")) show(e, r);
        else hide();
      }, { passive: false });
    });
    document.addEventListener("touchstart", (e) => {
      if (!fig.contains(e.target as Node)) hide();
    }, { passive: true });
  }
</script>
