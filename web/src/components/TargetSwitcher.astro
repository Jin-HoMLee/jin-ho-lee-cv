---
// Client-side positioning switcher (Phase 8c).
//
// Lets a visitor re-position the CV for a target audience without a page reload.
// Bridge is rendered at build time and stays SEO-canonical. The target headline
// updates in IdentityHero; CodeHero and the PDF menu follow the same event. The
// short answer line beneath the headline is deliberately shared across targets.
//
// Pure progressive enhancement: with JS off, the control stays hidden and the
// page is the complete bridge CV. Variant text is inlined at build time via
// `define:vars` — no runtime fetch, no served data asset.
//
// Every call to apply() (both the initial localStorage restore and a live
// click) also dispatches a `cv-target-change` CustomEvent on `window`, so
// other independently-mounted islands — e.g. PdfDownloadMenu.astro's header
// download links — can follow the selected variant with no shared module and
// no reload.
import type { Lang } from "../types/content";

interface Variant {
  headline?: string;
  tagline?: string;
  hero_stack?: string[];
}

interface Props {
  variants: Record<string, Variant>;
  lang: Lang;
}

const { variants, lang } = Astro.props as Props;

const labels = {
  en: { intro: "View as", bridge: "Default", "comp-bio": "Comp Bio", "ds-ml": "DS · ML" },
  de: { intro: "Ansicht", bridge: "Standard", "comp-bio": "Comp Bio", "ds-ml": "DS · ML" },
} as const;

const t = labels[lang];
const order = ["bridge", "ds-ml", "comp-bio"] as const;
---
<div
  data-cv-switcher
  role="group"
  aria-label={t.intro}
  class="lens hidden flex-wrap items-center gap-2 text-xs"
>
  <span class="lens-label">{t.intro}</span>
  <div class="flex flex-wrap gap-1">
    {order.map((id) => (
      <button
        type="button"
        data-cv-target={id}
        aria-pressed={id === "bridge" ? "true" : "false"}
        class="lens-button"
      >
        {t[id]}
      </button>
    ))}
  </div>
</div>
<style>
  .lens-label { align-self:center; color:var(--muted); font:10px "IBM Plex Mono",monospace; letter-spacing:.08em; text-transform:uppercase; }
  .lens-button { display:inline-flex; align-items:center; gap:5px; border:1px solid var(--surface-border); background:transparent; color:var(--text); padding:7px 10px; border-radius:999px; font-size:11px; font-weight:600; cursor:pointer; }
  .lens-button:hover { border-color:var(--accent); }
  .lens-button[aria-pressed="true"] { background:var(--accent); color:var(--accent-contrast); border-color:var(--accent); }
  .lens-button[aria-pressed="true"]::before { content:"✓"; font:700 10px "IBM Plex Mono",monospace; }
  @media(max-width:700px) { .lens { justify-content:flex-start; } .lens-label { width:100%; } }
</style>

<script is:inline define:vars={{ variants }}>
  document.addEventListener("DOMContentLoaded", () => {
    const root = document.querySelector("[data-cv-switcher]");
    if (!root) return;

    const buttons = Array.from(root.querySelectorAll("[data-cv-target]"));
    // DOM field name -> key in the variants JSON.
    const FIELDS = { headline: "headline" };
    const STORAGE_KEY = "cvTargetPreference";
    const VALID = new Set(["bridge", "comp-bio", "ds-ml"]);

    // Snapshot the build-time bridge text so "Default" restores it exactly.
    const bridge = {};
    for (const field of Object.keys(FIELDS)) {
      const el = document.querySelector(`[data-cv-field="${field}"]`);
      if (el) bridge[field] = el.textContent;
    }

    function apply(target, animate = true) {
      const overrides = target === "bridge" ? null : variants[target];
      for (const [field, jsonKey] of Object.entries(FIELDS)) {
        const el = document.querySelector(`[data-cv-field="${field}"]`);
        if (!el) continue;
        const value = overrides && overrides[jsonKey] != null ? overrides[jsonKey] : bridge[field];
        if (value != null) el.textContent = value;
      }
      // Publications depth: comp-bio shows the verbatim list; bridge/ds-ml the
      // aggregate. Charts (rendered outside both blocks) stay visible for all.
      const showFull = target === "comp-bio";
      const fullBlock = document.querySelector('[data-cv-pub="full"]');
      const aggBlock = document.querySelector('[data-cv-pub="aggregate"]');
      if (fullBlock) fullBlock.hidden = !showFull;
      if (aggBlock) aggBlock.hidden = showFull;

      for (const btn of buttons) {
        btn.setAttribute("aria-pressed", String(btn.dataset.cvTarget === target));
      }

      // Let other independently-mounted islands (e.g. the header PDF download
      // menu) react to the selected variant without a shared module or reload.
      window.dispatchEvent(new CustomEvent("cv-target-change", {
        detail: {
          target,
          headline: overrides?.headline,
          tagline: overrides?.tagline,
          hero_stack: overrides?.hero_stack,
          animate,
        },
      }));
    }

    for (const btn of buttons) {
      btn.addEventListener("click", () => {
        const target = btn.dataset.cvTarget;
        apply(target);
        try {
          localStorage.setItem(STORAGE_KEY, target);
        } catch {
          /* storage may be unavailable (private mode); ignore */
        }
      });
    }

    // Restore a saved non-bridge preference BEFORE revealing the control, so a
    // returning visitor never sees "Default" active for a frame (avoids FOUC).
    let saved = null;
    try {
      saved = localStorage.getItem(STORAGE_KEY);
    } catch {
      /* ignore */
    }
    if (saved && VALID.has(saved) && saved !== "bridge") apply(saved, false);

    // Reveal the control now that behaviour is wired (progressive enhancement).
    root.classList.remove("hidden");
    root.classList.add("flex");
  });
</script>
