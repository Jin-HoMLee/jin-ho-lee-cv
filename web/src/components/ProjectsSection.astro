---
import type { Project, Labels, Lang } from "../types/content";
import { formatPeriod } from "../lib/period";
import { writeupByProjectId } from "../data/writeups";

interface Props {
  projects: Record<string, Project>;
  labels: Labels;
  lang: Lang;
}

const { projects, labels, lang } = Astro.props;

const categoryLabel: Record<Project["category"], { en: string; de: string }> = {
  "life-science": { en: "Life Science", de: "Lebenswissenschaften" },
  "data-science": { en: "Data Science", de: "Data Science" },
  "consulting":   { en: "Consulting",   de: "Beratung" },
};

const sectionLabel = { en: "Projects", de: "Projekte" };
const detailsLabel = { en: "Details", de: "Details" };
const writeupLinkLabel = { en: "Read the write-up", de: "Read in English" };

const grouped: Record<Project["category"], Project[]> = {
  "life-science": [],
  "data-science": [],
  "consulting": [],
};
for (const p of Object.values(projects)) {
  grouped[p.category].push(p);
}
const categoryOrder: Project["category"][] = ["life-science", "data-science", "consulting"];
---
<section id="projects" class="py-6">
  <h2 class="eyebrow mb-4">
    {sectionLabel[lang]}
  </h2>
  {categoryOrder.map((cat) => grouped[cat].length > 0 && (
    <div class="mb-6">
      <h3 class="mb-3 text-sm font-semibold text-[var(--text)]">{categoryLabel[cat][lang]}</h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {grouped[cat].map((p) => (
          <article id={p.id} class="rounded-md border border-[var(--surface-border)] p-4">
            <header class="mb-2">
              <p class="font-mono-plex text-xs text-[var(--faint)]">{p.id}</p>
              <h4 class="text-base font-semibold text-[var(--text)]">
                {p.title}
                <a
                  href={lang === "en" ? `/projects/${p.id}/` : `/de/projects/${p.id}/`}
                  class="ml-1 text-xs font-normal text-[var(--faint)] hover:text-[var(--text)]"
                  aria-label={lang === "en" ? `Open project page for ${p.title}` : `Projektseite für ${p.title} öffnen`}
                >↗</a>
              </h4>
              <p class="text-xs text-[var(--faint)]">
                {p.role} · {formatPeriod(p.period, labels)}
              </p>
            </header>
            <p class="mb-3 text-sm text-[var(--muted)]">{p.summary}</p>
            {(() => {
              const writeup = writeupByProjectId(p.id);
              return writeup && (
                <p class="mb-3">
                  <a
                    href={`/writeups/${writeup.slug}/`}
                    class="text-xs font-medium text-[var(--accent)] underline hover:text-[var(--text)]"
                  >
                    {writeupLinkLabel[lang]} →
                  </a>
                </p>
              );
            })()}
            <details class="text-sm">
              <summary class="cursor-pointer text-[var(--muted)] hover:text-[var(--text)]">
                {detailsLabel[lang]}
              </summary>
              <ul class="mt-2 space-y-1 text-[var(--muted)]">
                {p.contributions.map((c) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="text-[var(--faint)]">·</span>
                    <span>{c}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-2 text-sm italic text-[var(--muted)]">{p.outcome}</p>
              <p class="mt-3 flex flex-wrap gap-1">
                {p.technologies.map((t) => (
                  <span class="rounded bg-[var(--surface)] px-1.5 py-0.5 text-xs text-[var(--muted)]">{t}</span>
                ))}
              </p>
            </details>
          </article>
        ))}
      </div>
    </div>
  ))}
</section>
