---
import type { Project, Labels, Lang } from "../types/content";
import { formatPeriod } from "../lib/period";

interface Props {
  project: Project;
  labels: Labels;
  lang: Lang;
}

const { project, labels, lang } = Astro.props;

const backLabel = { en: "← Back to CV", de: "← Zurück zum Lebenslauf" }[lang];
const techLabel = { en: "Technologies", de: "Technologien" }[lang];
const contribLabel = { en: "Contributions", de: "Beiträge" }[lang];
const outcomeLabel = { en: "Outcome", de: "Ergebnis" }[lang];

const backHref = lang === "en" ? `/#${project.id}` : `/de/#${project.id}`;
---
<article class="mx-auto max-w-3xl">
  <nav class="mb-4 text-sm">
    <a href={backHref} class="text-[var(--muted)] underline hover:text-[var(--text)]">{backLabel}</a>
  </nav>

  <header class="mb-6">
    <p class="font-mono-plex text-xs text-[var(--faint)]">{project.id}</p>
    <h1 class="text-2xl font-semibold text-[var(--text)] md:text-3xl">{project.title}</h1>
    <p class="mt-2 text-sm text-[var(--muted)]">
      {project.role} · {formatPeriod(project.period, labels)}
    </p>
  </header>

  <p class="mb-6 text-base text-[var(--text)]">{project.summary}</p>

  <section class="mb-6">
    <h2 class="eyebrow mb-2">{techLabel}</h2>
    <p class="flex flex-wrap gap-1">
      {project.technologies.map((t) => (
        <span class="rounded bg-[var(--surface)] px-2 py-0.5 text-xs text-[var(--muted)]">{t}</span>
      ))}
    </p>
  </section>

  <section class="mb-6">
    <h2 class="eyebrow mb-2">{contribLabel}</h2>
    <ul class="space-y-1 text-sm text-[var(--text)]">
      {project.contributions.map((c) => (
        <li class="flex gap-2">
          <span aria-hidden="true" class="text-[var(--faint)]">·</span>
          <span>{c}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mb-6 rounded-md bg-[var(--surface)] p-4">
    <h2 class="eyebrow mb-1">{outcomeLabel}</h2>
    <p class="text-sm italic text-[var(--muted)]">{project.outcome}</p>
  </section>
</article>
