---
const endpoint = import.meta.env.PUBLIC_TWIN_ENDPOINT ?? "";
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const starters = [
  "What's the splice neoepitope pipeline you built?",
  "Why the move from academia to industry?",
  "What's your experience with ML?",
];
---
{endpoint && (
  <div id="twin-root" data-endpoint={endpoint} data-sitekey={siteKey}>
    <button
      id="twin-launch"
      aria-label="Ask my digital twin"
      aria-controls="twin-panel"
      aria-expanded="false"
    >Ask my digital twin</button>
    <section id="twin-panel" hidden aria-labelledby="twin-title">
      <header>
        <strong id="twin-title">Jin-Ho's digital twin</strong>
        <p class="twin-preamble">
          Hi — I'm Jin-Ho's digital twin. Ask me anything about my work and I'll answer
          from my actual CV. <span>Chats may be reviewed to improve the twin.</span>
        </p>
      </header>
      <div id="twin-log" aria-live="polite" aria-atomic="false"></div>
      <ul id="twin-starters">{starters.map((q) => <li><button data-q={q}>{q}</button></li>)}</ul>
      <form id="twin-form">
        <input id="twin-input" type="text" autocomplete="off" placeholder="Ask about my work…" />
        <button type="submit">Send</button>
      </form>
      <div class="cf-turnstile" data-sitekey={siteKey}></div>
    </section>
  </div>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    import { streamTwin } from "../lib/twin";
    const root = document.getElementById("twin-root")!;
    const endpoint = root.dataset.endpoint!;
    const launch = document.getElementById("twin-launch")!;
    const panel = document.getElementById("twin-panel")!;
    const log = document.getElementById("twin-log")!;
    const form = document.getElementById("twin-form") as HTMLFormElement;
    const input = document.getElementById("twin-input") as HTMLInputElement;
    const history: { role: "user" | "assistant"; content: string }[] = [];

    // Mirror open state to aria-expanded and focus the input so keyboard/SR
    // users aren't stranded; Escape closes and returns focus to the launcher.
    function setPanelOpen(open: boolean): void {
      panel.hidden = !open;
      launch.setAttribute("aria-expanded", String(open));
      if (open) input.focus();
    }
    launch.addEventListener("click", () => setPanelOpen(panel.hidden));
    panel.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) {
        setPanelOpen(false);
        launch.focus();
      }
    });
    document.getElementById("twin-starters")!.addEventListener("click", (e) => {
      const q = (e.target as HTMLElement).dataset.q;
      if (q) { input.value = q; form.requestSubmit(); }
    });

    function bubble(role: string, text: string): HTMLElement {
      const el = document.createElement("div");
      el.className = `twin-msg twin-${role}`;
      el.textContent = text;
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    // Surface a short inline notice (no request fired) — reuses the assistant
    // bubble styling so it reads as the twin speaking.
    function notice(text: string): void {
      bubble("assistant", text);
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;

      // Turnstile is single-use: the Worker re-verifies every request and
      // Cloudflare rejects an already-redeemed token, so we must mint a fresh
      // one per turn. If the challenge hasn't been solved yet getResponse()
      // returns "" — don't fire a guaranteed-403 request; ask the user to retry
      // once the widget finishes (it auto-executes).
      // @ts-expect-error — Turnstile global from the injected script.
      const token = window.turnstile?.getResponse?.() ?? "";
      if (!token) {
        notice("One sec — solving a quick anti-spam check, try again.");
        input.focus();
        return;
      }

      input.value = "";
      bubble("user", q);
      history.push({ role: "user", content: q });
      const out = bubble("assistant", "");
      let acc = "";
      try {
        for await (const chunk of streamTwin(endpoint, history, token)) {
          if (chunk.type === "text") {
            acc += chunk.text;
          } else if (chunk.type === "truncated") {
            acc += " …(trimmed — ask me to go on)";
          }
          out.textContent = acc;
          log.scrollTop = log.scrollHeight;
        }
        history.push({ role: "assistant", content: acc });
      } catch {
        // Mid-stream failure: the assistant turn was never recorded, so pop the
        // orphaned user turn — otherwise the next submit sends two user turns in
        // a row and Anthropic rejects the non-alternating roles, cascading errors.
        // (#7 the empty bubble flashes briefly; #9 errors aren't granular — both
        // MVP-acceptable.)
        history.pop();
        out.textContent =
          "My twin's resting right now — meanwhile, grab my CV PDF or email me from the links above.";
      } finally {
        // Invalidate the just-used token and re-mint a fresh one for the next
        // turn (the managed widget auto-executes after reset) — without this the
        // 2nd message in a conversation reuses a redeemed token and 403s.
        // @ts-expect-error — Turnstile global from the injected script.
        window.turnstile?.reset?.();
      }
    });
  </script>

  <style>
    /* All colors/surfaces/borders pull from the site's theme custom properties
       (defined in global.css) so the widget tracks dark/light automatically. */
    #twin-root {
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 50;
      font-size: 0.875rem;
    }

    #twin-launch {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.875rem;
      border-radius: 9999px;
      border: 1px solid var(--surface-border);
      background: var(--surface);
      color: var(--text);
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 16px rgb(0 0 0 / 0.25);
      transition: color 0.15s, border-color 0.15s, background 0.15s;
    }
    #twin-launch:hover {
      color: var(--accent);
      border-color: var(--accent);
    }

    #twin-panel {
      position: absolute;
      right: 0;
      bottom: calc(100% + 0.5rem);
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      width: min(22rem, calc(100vw - 2rem));
      max-height: min(32rem, calc(100vh - 6rem));
      padding: 0.875rem;
      border-radius: 0.75rem;
      border: 1px solid var(--surface-border);
      background: var(--surface);
      color: var(--text);
      box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
    }
    #twin-panel[hidden] { display: none; }

    #twin-panel header strong {
      font-size: 0.9375rem;
      color: var(--text);
    }
    .twin-preamble {
      margin: 0.25rem 0 0;
      font-size: 0.75rem;
      line-height: 1.4;
      color: var(--muted);
    }
    .twin-preamble span {
      /* Real data-review disclosure — must stay legible. --faint on light
         --surface is ~4.0:1 (under WCAG AA for 0.75rem); --muted passes. */
      color: var(--muted);
    }

    #twin-log {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      overflow-y: auto;
      flex: 1 1 auto;
      min-height: 0;
    }
    #twin-log:empty { display: none; }

    .twin-msg {
      max-width: 85%;
      padding: 0.5rem 0.625rem;
      border-radius: 0.625rem;
      line-height: 1.45;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .twin-user {
      align-self: flex-end;
      background: var(--accent);
      color: var(--accent-contrast);
    }
    .twin-assistant {
      align-self: flex-start;
      background: var(--surface-2);
      color: var(--text);
      border: 1px solid var(--surface-border);
    }

    #twin-starters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    #twin-starters button {
      padding: 0.3125rem 0.625rem;
      border-radius: 9999px;
      border: 1px solid var(--surface-border);
      background: var(--surface-2);
      color: var(--muted);
      font-size: 0.75rem;
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s;
    }
    #twin-starters button:hover {
      color: var(--accent);
      border-color: var(--accent);
    }

    #twin-form {
      display: flex;
      gap: 0.5rem;
    }
    #twin-input {
      flex: 1 1 auto;
      min-width: 0;
      padding: 0.5rem 0.625rem;
      border-radius: 0.5rem;
      border: 1px solid var(--surface-border);
      background: var(--bg);
      color: var(--text);
      font: inherit;
    }
    #twin-input::placeholder { color: var(--faint); }
    #twin-input:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }
    #twin-form button[type="submit"] {
      padding: 0.5rem 0.875rem;
      border-radius: 0.5rem;
      border: none;
      background: var(--accent);
      color: var(--accent-contrast);
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    #twin-form button[type="submit"]:hover { background: var(--accent-hover); }
  </style>
)}
