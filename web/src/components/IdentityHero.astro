---
import type { Personal, Profile, Lang } from "../types/content";
import { FOCUS_MARKS, FOCUS_TARGETS } from "../lib/focus-mark";
import TargetSwitcher from "./TargetSwitcher.astro";
interface Variant { headline?:string; tagline?:string; hero_stack?:string[] }
interface Props { personal:Personal; profile:Profile; lang:Lang; variants:Record<string,Variant> }
const { personal, profile, lang, variants } = Astro.props;
const copy = lang === "de"
  ? { location:`${personal.name.given} ${personal.name.family} · Mannheim, Deutschland`, portrait:"Porträt von Jin-Ho Lee", focus:"Arbeitsprinzip", vector:"Vektor · zielbezogen", title:"Von Evidenz zu Wirkung", sub:"Forschungsnahe Evidenz · Produktionssysteme · Mentoring" }
  : { location:`${personal.name.given} ${personal.name.family} · Mannheim, Germany`, portrait:"Portrait of Jin-Ho Lee", focus:"Operating principle", vector:"Vector · target-aware", title:"From evidence to impact", sub:"Research-grade evidence · production systems · human mentorship" };
---
<section id="identity" class="identity-hero" data-identity-hero data-reveal>
  <div class="identity-copy">
    <div class="identity-toolbar">
      <p class="identity-overline">{copy.location}</p>
      <TargetSwitcher variants={variants} lang={lang} />
    </div>
    <figure class="identity-portrait">
      <img src="/photo.jpg" width="138" height="166" alt={copy.portrait} loading="eager" />
    </figure>
    <h1 data-cv-field="headline">{personal.headline}</h1>
    <p class="hero-lede" data-cv-field="answer-block">{profile.answer_block ?? profile.tagline}</p>
  </div>
  <aside class="focus-panel">
    <span class="vector-label">{copy.vector}</span>
    <div class="focus-art" data-focus-art="bridge" data-focus-target="bridge" aria-hidden="true">
      <svg viewBox="0 0 500 230" data-focus-mark>
        <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" data-focus-edges>
          {FOCUS_MARKS.bridge.edges.map((item, index) => <path data-focus-edge={index} d={`M${item.x} ${item.y}L${item.toX} ${item.toY}`} opacity={item.opacity} stroke-width={item.strokeWidth} />)}
        </g>
        <g data-focus-nodes>
          {FOCUS_MARKS.bridge.nodes.map((item, index) => <circle data-focus-node={index} cx={item.x} cy={item.y} r={item.r} opacity={item.opacity} fill={item.fill} stroke={item.stroke} stroke-width={item.strokeWidth} />)}
        </g>
        <g fill="none" stroke="currentColor" data-focus-rings>
          {FOCUS_MARKS.bridge.rings.map((item, index) => <circle data-focus-ring={index} cx={item.x} cy={item.y} r={item.r} opacity={item.opacity} stroke-width={item.strokeWidth} stroke-dasharray={item.dash} />)}
        </g>
      </svg>
    </div>
    <div class="focus-copy">
      <p class="focus-kicker">{copy.focus}</p>
      <h2 data-focus-title>{copy.title}</h2>
      <p data-focus-sub>{copy.sub}</p>
    </div>
  </aside>
</section>
<script is:inline define:vars={{ focusMarks: FOCUS_MARKS, focusTargets: FOCUS_TARGETS }}>
  document.addEventListener("DOMContentLoaded", () => {
    const hero = document.querySelector("[data-identity-hero]");
    const art = hero?.querySelector("[data-focus-art]");
    const svg = art?.querySelector("[data-focus-mark]");
    if (!hero || !art || !svg) return;

    const lang = document.documentElement.lang;
    const focus = lang === "de" ? {
      bridge:"Forschungsnahe Evidenz · Produktionssysteme · Mentoring",
      "ds-ml":"GCP · BigQueryML · KI-Systeme",
      "comp-bio":"NGS · HLA-Typisierung · Splice-Kandidaten",
    } : {
      bridge:"Research-grade evidence · production systems · human mentorship",
      "ds-ml":"GCP · BigQueryML · AI systems",
      "comp-bio":"NGS · HLA typing · splice-derived candidates",
    };
    const edges = Array.from(svg.querySelectorAll("[data-focus-edge]"));
    const nodes = Array.from(svg.querySelectorAll("[data-focus-node]"));
    const rings = Array.from(svg.querySelectorAll("[data-focus-ring]"));
    const initial = focusMarks.bridge;
    let current = initial;
    let frame = 0;
    let transitionId = 0;
    let activeTarget = "bridge";
    const reduced = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
    const number = (value) => String(Number(value.toFixed(4)));
    const render = (mark) => {
      mark.edges.forEach((item, index) => {
        const path = edges[index];
        if (!path) return;
        path.setAttribute("d", `M${number(item.x)} ${number(item.y)}L${number(item.toX)} ${number(item.toY)}`);
        path.setAttribute("opacity", number(item.opacity));
        path.setAttribute("stroke-width", number(item.strokeWidth));
      });
      mark.nodes.forEach((item, index) => {
        const node = nodes[index];
        if (!node) return;
        node.setAttribute("cx", number(item.x));
        node.setAttribute("cy", number(item.y));
        node.setAttribute("r", number(item.r));
        node.setAttribute("opacity", number(item.opacity));
        node.setAttribute("fill", item.fill);
        node.setAttribute("stroke", item.stroke);
        node.setAttribute("stroke-width", number(item.strokeWidth));
      });
      mark.rings.forEach((item, index) => {
        const ring = rings[index];
        if (!ring) return;
        ring.setAttribute("cx", number(item.x));
        ring.setAttribute("cy", number(item.y));
        ring.setAttribute("r", number(item.r));
        ring.setAttribute("opacity", number(item.opacity));
        ring.setAttribute("stroke-width", number(item.strokeWidth));
        ring.setAttribute("stroke-dasharray", item.dash);
      });
    };
    const updateCopy = (target) => {
      const sub = hero.querySelector("[data-focus-sub]");
      if (sub) sub.textContent = focus[target];
      art.dataset.focusTarget = target;
    };
    const transition = (target, animate = true) => {
      if (!focusTargets.includes(target) || target === activeTarget && !frame) return;
      cancelAnimationFrame(frame);
      frame = 0;
      const id = ++transitionId;
      activeTarget = target;
      const destination = focusMarks[target];
      const start = current;
      if (!animate || reduced()) {
        current = destination;
        render(destination);
        updateCopy(target);
        frame = 0;
        return;
      }
      const started = performance.now();
      const duration = 560;
      const tick = (now) => {
        // A RAF timestamp is the frame's start time, so it can be slightly
        // earlier than `started` when a lens event arrives during that frame.
        // Clamp both ends: an unclamped negative progress creates invalid SVG
        // radii while a stale callback can otherwise overwrite a retargeted
        // animation.
        if (id !== transitionId) return;
        const elapsed = now - started;
        const progress = Number.isFinite(elapsed) ? Math.max(0, Math.min(1, elapsed / duration)) : 0;
        const eased = 1 - Math.pow(1 - progress, 3);
        current = interpolate(start, destination, eased);
        render(current);
        if (progress < 1) frame = requestAnimationFrame(tick);
        else { frame = 0; current = destination; render(destination); updateCopy(target); }
      };
      frame = requestAnimationFrame(tick);
    };
    // Keep interpolation in the inline island so static HTML remains a complete
    // fallback and no runtime module fetch is needed.
    const interpolate = (from, to, progress) => {
      const mix = (a, b) => a + (b - a) * progress;
      return {
        edges: to.edges.map((item, i) => { const source = from.edges[i]; return { ...item, x: mix(source.x, item.x), y: mix(source.y, item.y), toX: mix(source.toX, item.toX), toY: mix(source.toY, item.toY), opacity: mix(source.opacity, item.opacity), strokeWidth: mix(source.strokeWidth, item.strokeWidth) }; }),
        nodes: to.nodes.map((item, i) => { const source = from.nodes[i]; return { ...item, x: mix(source.x, item.x), y: mix(source.y, item.y), r: mix(source.r, item.r), opacity: mix(source.opacity, item.opacity), strokeWidth: mix(source.strokeWidth, item.strokeWidth) }; }),
        rings: to.rings.map((item, i) => { const source = from.rings[i]; return { ...item, x: mix(source.x, item.x), y: mix(source.y, item.y), r: mix(source.r, item.r), opacity: mix(source.opacity, item.opacity), strokeWidth: mix(source.strokeWidth, item.strokeWidth) }; }),
      };
    };
    window.addEventListener("cv-target-change", (event) => {
      const detail = event.detail ?? {};
      if (!focusTargets.includes(detail.target)) return;
      transition(detail.target, detail.animate !== false);
      const sub = hero.querySelector("[data-focus-sub]");
      if (sub && reduced()) sub.textContent = focus[detail.target];
    });

    const motionQuery = window.matchMedia?.("(prefers-reduced-motion: reduce)");
    motionQuery?.addEventListener?.("change", (event) => {
      if (!event.matches || !frame) return;
      cancelAnimationFrame(frame);
      frame = 0;
      transitionId += 1;
      current = focusMarks[activeTarget];
      render(current);
      updateCopy(activeTarget);
    });

    // The switcher's restore event can run before this island's DOMContentLoaded
    // callback. Read the same preference here so a persisted lens always wins.
    try {
      const saved = localStorage.getItem("cvTargetPreference");
      if (saved && focusTargets.includes(saved) && saved !== "bridge") transition(saved, false);
    } catch {
      /* storage may be unavailable (private mode); keep the static bridge */
    }
  });
</script>
<style>
  .identity-hero { position:relative; display:grid; grid-template-columns:7fr 5fr; gap:3.5rem; align-items:start; padding:5.1rem 0 3.4rem; }
  .identity-hero::before { content:"01 / IDENTITY"; position:absolute; top:2.85rem; left:0; color:var(--accent); font:10px "IBM Plex Mono",monospace; letter-spacing:.12em; }
  .identity-toolbar { display:flex; align-items:center; justify-content:space-between; gap:1.25rem; margin-bottom:1rem; }
  .identity-overline { margin:0; color:var(--gold); font:700 12px "IBM Plex Mono",monospace; text-transform:uppercase; letter-spacing:.16em; }
  .identity-portrait { width:138px; margin:.25rem 0 1.5rem; }
  .identity-portrait img { display:block; width:138px; height:166px; object-fit:cover; object-position:center; filter:grayscale(1) contrast(1.05); border:1px solid var(--gold); box-shadow:8px 8px 0 color-mix(in srgb,var(--accent) 10%,transparent); }
  h1 { margin:.8rem 0 1.3rem; font-size:clamp(3rem,7vw,5.15rem); line-height:.95; letter-spacing:-.055em; font-weight:700; }
  .hero-lede { max-width:42rem; margin:0; color:var(--muted); font-size:1.15rem; line-height:1.55; }
  .focus-panel { position:relative; overflow:hidden; margin-top:3rem; padding:1.75rem; border:1px solid var(--surface-border); border-radius:2px; background:var(--surface); box-shadow:8px 8px 0 color-mix(in srgb,var(--accent) 15%,transparent); }
  .vector-label { position:absolute; right:.75rem; top:.6rem; color:var(--muted); font:9px "IBM Plex Mono",monospace; text-transform:uppercase; letter-spacing:.08em; }
  .focus-art { min-height:190px; color:var(--accent); margin:-.5rem -.4rem .6rem; }
  .focus-art svg { width:100%; height:190px; }
  .focus-art svg * { vector-effect:non-scaling-stroke; stroke-linecap:round; stroke-linejoin:round; }
  .focus-kicker { margin:0; color:var(--accent-hover); font:700 11px "IBM Plex Mono",monospace; text-transform:uppercase; letter-spacing:.14em; }
  .focus-panel h2 { margin:.3rem 0; font-size:1.9rem; line-height:1.05; font-weight:700; }
  .focus-copy > p:last-child { margin-bottom:0; }
  @media(max-width:980px) {
    .identity-hero { grid-template-columns:1fr; gap:2rem; }
    .focus-panel { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:1.5rem; align-items:end; margin-top:0; }
  }
  @media(max-width:700px) {
    .identity-hero { padding-top:3.4rem; gap:1rem; }
    .identity-hero::before { top:1.25rem; }
    .identity-toolbar { display:block; }
    .identity-overline { margin-bottom:.8rem; }
    .identity-portrait,.identity-portrait img { width:112px; }
    .identity-portrait img { height:134px; }
    h1 { font-size:3rem; }
    .hero-lede { font-size:1.05rem; line-height:1.45; }
    .focus-panel { display:block; padding:1rem; }
    .focus-art { min-height:70px; margin:-.25rem -.2rem .25rem; }
    .focus-art svg { height:70px; }
    .focus-panel h2 { font-size:1.45rem; }
    .focus-copy > p:last-child { font-size:.9rem; }
  }
</style>
