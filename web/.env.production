# Loaded automatically by `astro build` / `astro preview` (i.e. `just web-build`)
# — production mode. No manual switching: Vite picks this over .env when
# MODE=production.
#
# Points the twin widget at the deployed Worker + the real Turnstile site key.
# CI (.github/workflows/pages.yml) injects these SAME two values from GitHub repo
# *variables* at deploy time, so the deployed site doesn't depend on this file —
# it only makes a LOCAL production build / `astro preview` behave like prod.
#
# Both values are PUBLIC (client-exposed) and non-secret, so this is committed.
# Real secrets (Turnstile SECRET key, Gemini key) live as Worker secrets, never here.
PUBLIC_TWIN_ENDPOINT=https://jin-ho-lee-cv-twin.jinho-michael-lee.workers.dev
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADl8qPYtCeeJytO9
