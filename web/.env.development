# Loaded automatically by `astro dev` (i.e. `just web-dev`) — development mode.
# No manual switching: Vite picks this file over .env when MODE=development.
#
# Points the twin widget at the LOCAL Worker (`just worker-dev`, port 8787) and
# uses Cloudflare's always-pass Turnstile TEST site key — which pairs with the
# test SECRET in worker/.dev.vars and verifies on localhost (the real site key
# rejects any host not in its allowlist with error 110200).
#
# Every value here is PUBLIC (client-exposed by definition) and non-secret, so
# it's committed — a fresh clone gets a working local dev loop with zero setup.
PUBLIC_TWIN_ENDPOINT=http://localhost:8787
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
